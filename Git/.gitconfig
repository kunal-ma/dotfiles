[user]
	name = Kunal M.A.
	email = 311509726+kunal-ma@users.noreply.github.com
	username = kunal-ma
[init]
	defaultBranch = main
[core]
	autocrlf = true
	fscache = true
	symlinks = false
	editor = code --wait
	pager = 
	excludesFile = E:\\GitHub\\.gitignore
[color]
	interactive = true
	ui = auto
[color "branch"]
	current = yellow bold
	local = green bold
	remote = cyan bold
[color "diff"]
	meta = yellow bold
	frag = magenta bold
	old = red bold
	new = green bold
	whitespace = red reverse
[color "status"]
	added = green bold
	changed = yellow bold
	untracked = red bold
[pull]
	rebase = false
[credential]
	helper = manager
[fetch]
    prune = true
[alias]
    logs = log -p --stat --pretty=fuller
    graph = log --oneline --graph --all --decorate
    compare = "!f() { \
        index=$(git rev-parse --git-path index) || exit 1; \
        tmp=$(mktemp) || exit 1; \
        trap 'rm -f \"$tmp\"' EXIT; \
        cp \"$index\" \"$tmp\" || exit 1; \
        GIT_INDEX_FILE=\"$tmp\" git add -N -- . || exit $?; \
        GIT_INDEX_FILE=\"$tmp\" git diff --full-index -- \"$@\"; \
    }; f"
