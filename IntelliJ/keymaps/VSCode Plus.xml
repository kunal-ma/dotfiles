<keymap version="1" name="VSCode Plus" parent="$default">
  <!-- Window controls -->
  <action id="SplitVertically">
    <keyboard-shortcut first-keystroke="ctrl back_slash" />
  </action>
  <action id="HideSideWindows">
    <keyboard-shortcut first-keystroke="alt f1" />
  </action>
  <action id="CloseContent">
    <keyboard-shortcut first-keystroke="ctrl f4" />
  </action>
  <action id="CloseAllEditors">
    <keyboard-shortcut first-keystroke="ctrl w" />
  </action>
  <action id="CloseProject">
    <keyboard-shortcut first-keystroke="alt q" />
  </action>
  <!-- Editor controls -->
  <action id="CommentByLineComment">
    <keyboard-shortcut first-keystroke="ctrl slash" />
  </action>
  <action id="Find">
    <keyboard-shortcut first-keystroke="ctrl f" />
  </action>
  <action id="Replace">
    <keyboard-shortcut first-keystroke="ctrl h" />
  </action>
  <action id="$Redo">
    <keyboard-shortcut first-keystroke="ctrl y"/>
  </action>
  <action id="CodeCompletion">
    <keyboard-shortcut first-keystroke="ctrl space" />
  </action>
  <!-- Search and Explore -->
  <action id="GotoFile">
    <keyboard-shortcut first-keystroke="ctrl p" />
  </action>
  <action id="GotoAction">
    <keyboard-shortcut first-keystroke="ctrl shift p" />
  </action>
  <action id="GotoImplementation">
    <keyboard-shortcut first-keystroke="f3" />
  </action>
  <action id="GotoDeclaration">
    <keyboard-shortcut first-keystroke="ctrl f3" />
  </action>
  <action id="SearchEverywhere">
    <keyboard-shortcut first-keystroke="f1" />
  </action>
  <!-- Tool Windows -->
  <action id="ActivateProblemsViewToolWindow">
    <keyboard-shortcut first-keystroke="ctrl shift m"  />
  </action>
  <action id="ActivateRunToolWindow">
    <keyboard-shortcut first-keystroke="ctrl shift u" />
  </action>
  <action id="ActivateTerminalToolWindow">
    <keyboard-shortcut first-keystroke="ctrl back_quote" />
  </action>
  <action id="ActivateVersionControlToolWindow">
    <keyboard-shortcut first-keystroke="ctrl shift g" />
  </action>
  <!-- Run Configuration -->
  <action id="Run">
    <keyboard-shortcut first-keystroke="f5" />
  </action>
  <action id="ChooseRunConfiguration">
    <keyboard-shortcut first-keystroke="ctrl f5" />
  </action>
  <!-- Miscellaneous -->
  <action id="ShowSettings">
    <keyboard-shortcut first-keystroke="ctrl comma" />
  </action>
</keymap>
